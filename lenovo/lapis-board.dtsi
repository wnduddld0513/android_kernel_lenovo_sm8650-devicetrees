&sdhc_2 {
	status = "ok";
	vdd-supply = <&pm_humu_l9>;
	qcom,vdd-voltage-level = <0x2d0370 0x2d2a80>;
	qcom,vdd-current-level = <0x0 0xc3500>;
	vdd-io-supply = <&pm_humu_l8>;
	qcom,vdd-io-voltage-level = <0x1b7740 0x2d2a80>;
	qcom,vdd-io-current-level = <0x0 0x2710>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&sdc2_on &sd_card_det_default>;
	pinctrl-1 = <&sdc2_off &sd_card_det_default>;
	cd-gpios = <&pm8550_gpios 0xc 0x1>;
	resets = <&gcc 0x17>;
	reset-names = "core_reset";
	qcom,iommu-dma = "fastmap";
	qcom,uses_level_shifter;
};

&soc {

	gpio_keys {
		compatible = "gpio-keys";
		label = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&key_vol_up_default>;

		vol_up {
			label = "volume_up";
			gpios = <&pm8550_gpios 0x6 0x1>;
			linux,input-type = <0x1>;
			linux,code = <0x73>;
			gpio-key,wakeup;
			debounce-interval = <0xf>;
			linux,can-disable;
		};
	};
};

&ufsphy_mem {
	compatible = "qcom,ufs-phy-qmp-v4-pineapple";
	vdda-phy-supply = <&pm_v6d_l1>;
	vdda-phy-max-microamp = <0x33838>;
	vdda-phy-min-microvolt = <0xdea80>;
	vdda-pll-supply = <&pm_v8_l3>;
	vdda-pll-max-microamp = <0x477c>;
	vdd-phy-gdsc-supply = <&gcc_ufs_mem_phy_gdsc>;
	vdda-qref-supply = <&pm_v8_l1>;
	vdda-qref-max-microamp = <0xfbf4>;
	status = "ok";
};

&ufshc_mem {
	vdd-hba-supply = <&gcc_ufs_phy_gdsc>;
	vcc-supply = <&pm_humu_l17>;
	vcc-max-microamp = <0x13d620>;
	vccq-supply = <&pm_v6c_l1>;
	vccq-max-microamp = <0x124f80>;
	qcom,vddp-ref-clk-supply = <&pm_v6c_l3>;
	qcom,vddp-ref-clk-max-microamp = <0x64>;
	qcom,vccq-parent-supply = <&pm_v6c_s1>;
	qcom,vccq-parent-max-microamp = <0x33450>;
	qcom,vccq-shutdown-supply = <&pm_v6c_l1>;
	qcom,vccq-shutdown-max-microamp = <0x124f80>;
	reset-gpios = <&tlmm 0xd2 0x1>;
	resets = <&gcc 0x19>;
	reset-names = "rst";
	status = "ok";
};
