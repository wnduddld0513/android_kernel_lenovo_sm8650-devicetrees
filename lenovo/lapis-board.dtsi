&spmi_bus {
	#address-cells = <0x2>;
	#size-cells = <0x0>;
	interrupt-controller;
	#interrupt-cells = <0x4>;

	qcom,pmk8550@0 {
		compatible = "qcom,spmi-pmic";
		reg = <0x0 0x0>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		sdam@7000 {
			compatible = "qcom,spmi-sdam";
			reg = <0x7000>;
			#address-cells = <0x1>;
			#size-cells = <0x1>;

			smb1510_present@5d {
				reg = <0x5d 0x1>;
				bits = <0x5 0x5>;
			};

			ocp_log: ocp-log@76 {
				reg = <0x76 0x6>;
			};
		};

		sdam@7100 {
			compatible = "qcom,spmi-sdam";
			reg = <0x7100>;
			#address-cells = <0x1>;
			#size-cells = <0x1>;

			restart_reason: restart@48 {
				reg = <0x48 0x1>;
				bits = <0x1 0x7>;
			};

			wr_thermal_flag: wr_thermal-flag@58 {
				reg = <0x58 0x1>;
			};

			alarm_log: alarm-log@76 {
				reg = <0x76 0x6>;
			};

			fmd-set@9a {
				reg = <0x9a 0x1>;
			};
		};

		pmk8550_sdam_5: sdam@7400 {
			compatible = "qcom,spmi-sdam";
			reg = <0x7400>;
		};

		pmk8550_sdam_6: sdam@7500 {
			compatible = "qcom,spmi-sdam";
			reg = <0x7500>;
		};

		sdam@7c00 {
			compatible = "qcom,spmi-sdam";
			reg = <0x7c00>;
		};

		sdam@7d00 {
			compatible = "qcom,spmi-sdam";
			reg = <0x7d00>;
		};

		pmk8550_sdam_21: sdam@8400 {
			compatible = "qcom,spmi-sdam";
			reg = <0x8400>;
		};

		pmk8550_sdam_22: sdam@8500 {
			compatible = "qcom,spmi-sdam";
			reg = <0x8500>;
		};

		sdam@9800 {
			compatible = "qcom,spmi-sdam";
			reg = <0x9800>;
		};

		sdam@9a00 {
			compatible = "qcom,spmi-sdam";
			reg = <0x9a00>;
			#address-cells = <0x1>;
			#size-cells = <0x1>;

			sqm-timer@b8 {
				reg = <0xb8 0x2>;
			};
		};

		pmk8550_sdam_46: sdam@9d00 {
			compatible = "qcom,spmi-sdam";
			reg = <0x9d00>;
		};

		sdam@a000 {
			compatible = "qcom,spmi-sdam";
			reg = <0xa000>;
		};

		sdam@a400 {
			compatible = "qcom,spmi-sdam";
			reg = <0xa400>;
		};

		sdam@b600 {
			compatible = "qcom,spmi-sdam";
			reg = <0xb600>;

			usb_mode: usb-mode@50 {
				reg = <0x50 0x1>;
			};
		};

		pon_hlos@1300 {
			compatible = "qcom,pm8998-pon";
			reg = <0x1300 0x800>;
			reg-names = "pon_hlos", "pon_pbs";

			pwrkey {
				compatible = "qcom,pmk8350-pwrkey";
				interrupts = <0x0 0x13 0x7 0x3>;
				linux,code = <0x74>;
			};

			resin {
				compatible = "qcom,pmk8350-resin";
				interrupts = <0x0 0x13 0x6 0x3>;
				linux,code = <0x72>;
			};
		};

		pinctrl@b800 {
			compatible = "qcom,pmk8550-gpio";
			reg = <0xb800>;
			gpio-controller;
			#gpio-cells = <0x2>;
			interrupt-controller;
			#interrupt-cells = <0x2>;
			pinctrl-0 = <&alt_sleep_clk_default>;
			pinctrl-names = "default";

			alt_sleep_clk {

				alt_sleep_clk_default: alt_sleep_clk_default {
					pins = "gpio3";
					function = "func1";
					input-disable;
					output-enable;
					bias-disable;
					power-source = <0x0>;
				};
			};
		};

		qcom,pwms@e800 {
			status = "disabled";
			compatible = "qcom,pwm-lpg";
			reg = <0xe800>;
			reg-names = "lpg-base";
			qcom,num-lpg-channels = <0x1>;
			#pwm-cells = <0x2>;
		};

		qcom,pwms@e900 {
			status = "disabled";
			compatible = "qcom,pwm-lpg";
			reg = <0xe900>;
			reg-names = "lpg-base";
			qcom,num-lpg-channels = <0x1>;
			#pwm-cells = <0x2>;
		};

		rtc@6100 {
			compatible = "qcom,pmk8350-rtc";
			reg = <0x6100 0x6200>;
			reg-names = "rtc", "alarm";
			interrupts = <0x0 0x62 0x1 0x1>;
		};

		pmk8550_vadc: vadc@9000 {
			compatible = "qcom,spmi-adc5-gen3";
			reg = <0x9000 0x9100>;
			qcom,debug-base = <0x7600>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			interrupt-names = "adc-sdam0", "adc-sdam1";
			interrupts = <0x0 0x90 0x1 0x1 0x0 0x91 0x1 0x1>;
			#thermal-sensor-cells = <0x1>;
			#io-channel-cells = <0x1>;
			io-channel-ranges;
			pinctrl-names = "default";
			pinctrl-0 = <&pm8550_fast_chg_therm_default>;

			pmk8550_offset_ref {
				reg = <0x0>;
				label = "pmk8550_offset_ref";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pmk8550_vref_1p25 {
				reg = <0x1>;
				label = "pmk8550_vref_1p25";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pmk8550_die_temp {
				reg = <0x3>;
				label = "pmk8550_die_temp";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pmk8550_xo_therm {
				reg = <0x44>;
				label = "pmk8550_xo_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc-tm-type = <0x1>;
			};

			pm8550_offset_ref {
				reg = <0x100>;
				label = "pm8550_offset_ref";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pm8550_vref_1p25 {
				reg = <0x101>;
				label = "pm8550_vref_1p25";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pm8550_die_temp {
				reg = <0x103>;
				label = "pm8550_die_temp";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pm8550_vph_pwr {
				reg = <0x18e>;
				label = "pm8550_vph_pwr";
				qcom,pre-scaling = <0x1 0x3>;
			};

			pm8550b_offset_ref {
				reg = <0x700>;
				label = "pm8550b_offset_ref";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pm8550b_vref_1p25 {
				reg = <0x701>;
				label = "pm8550b_vref_1p25";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pm8550b_die_temp {
				reg = <0x703>;
				label = "pm8550b_die_temp";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pm8550b_lite_die_temp {
				reg = <0x718>;
				label = "pm8550b_lite_die_temp";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pm8550b_vph_pwr {
				reg = <0x78e>;
				label = "pm8550b_vph_pwr";
				qcom,pre-scaling = <0x1 0x3>;
			};

			pm8550b_vbat_sns_qbg {
				reg = <0x78f>;
				label = "pm8550b_vbat_sns_qbg";
				qcom,pre-scaling = <0x1 0x3>;
			};

			pm8550vs_c_die_temp {
				reg = <0x203>;
				label = "pm8550vs_c_die_temp";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pm8550vs_d_die_temp {
				reg = <0x303>;
				label = "pm8550vs_d_die_temp";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pm8550vs_e_die_temp {
				reg = <0x403>;
				label = "pm8550vs_e_die_temp";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pm8550vs_g_die_temp {
				reg = <0x603>;
				label = "pm8550vs_g_die_temp";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pm8550ve_die_temp {
				reg = <0x803>;
				label = "pm8550ve_die_temp";
				qcom,pre-scaling = <0x1 0x1>;
			};

			pm8550_quiet_therm {
				reg = <0x14b>;
				label = "pm8550_quiet_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc-tm-type = <0x1>;
			};

			pm8550_cam_flash_therm {
				reg = <0x145>;
				label = "pm8550_cam_flash_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc-tm-type = <0x1>;
			};

			pm8550_wlan_therm {
				reg = <0x146>;
				label = "pm8550_wlan_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc-tm-type = <0x1>;
			};

			pm8550_rear_tof_therm {
				reg = <0x148>;
				label = "pm8550_rear_tof_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc-tm-type = <0x1>;
			};

			pm8550b_ufs_therm {
				reg = <0x74b>;
				label = "pm8550b_ufs_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc-tm-type = <0x1>;
			};

			pm8550b_chg_temp {
				reg = <0x710>;
				label = "pm8550b_chg_temp";
			};

			pm8550b_iin_fb {
				reg = <0x717>;
				label = "pm8550b_iin_fb";
			};

			pm8550b_ichg_fb {
				reg = <0x7a1>;
				label = "pm8550b_ichg_fb";
			};

			pm8550_ap_therm {
				reg = <0x144>;
				label = "pm8550_ap_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc-tm-type = <0x1>;
			};

			pm8550_usb_conn_therm {
				reg = <0x147>;
				label = "pm8550_usb_conn_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc-tm-type = <0x1>;
			};

			pm8550_fast_chg_therm {
				reg = <0x14d>;
				label = "pm8550_fast_chg_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc-tm-type = <0x1>;
			};

			pm8550_back_chg_therm {
				reg = <0x14a>;
				label = "pm8550_back_chg_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc-tm-type = <0x1>;
			};

			pm8550b_top_chg_therm {
				reg = <0x749>;
				label = "pm8550b_top_chg_therm";
				qcom,ratiometric;
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc-tm-type = <0x1>;
			};

			pm8550b_batt1_therm {
				reg = <0x744>;
				label = "pm8550b_batt1_therm";
				qcom,ratiometric;
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc-tm-type = <0x1>;
			};

			pm8550b_usb1_conn_therm {
				reg = <0x747>;
				label = "pm8550b_usb1_conn_therm";
				qcom,ratiometric;
				qcom,pre-scaling = <0x1 0x1>;
				qcom,adc-tm-type = <0x1>;
			};
		};
	};
};

&spmi_bus {
	#address-cells = <0x2>;
	#size-cells = <0x0>;
	interrupt-controller;
	#interrupt-cells = <0x4>;

	qcom,pmr735d@a {
		compatible = "qcom,spmi-pmic";
		reg = <0xa 0x0>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		pmr735d_tz: pmr735d-temp-alarm@a00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xa00>;
			interrupts = <0xa 0xa 0x0 0x3>;
			#thermal-sensor-cells = <0x0>;
		};

		pinctrl@8800 {
			compatible = "qcom,pmr735d-gpio";
			reg = <0x8800>;
			gpio-controller;
			#gpio-cells = <0x2>;
			interrupt-controller;
			#interrupt-cells = <0x2>;
		};
	};
};

&thermal_zones {

	pmr735d_tz {
		polling-delay-passive = <0x64>;
		polling-delay = <0x0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pmr735d_tz>;

		trips {

			trip0 {
				temperature = <0x17318>;
				hysteresis = <0x0>;
				type = "passive";
			};

			trip1 {
				temperature = <0x1c138>;
				hysteresis = <0x0>;
				type = "passive";
			};

			trip2 {
				temperature = <0x23668>;
				hysteresis = <0x0>;
				type = "critical";
			};
		};
	};
};

&soc {

	qcom,gpu-dump-skip-cdev {
		compatible = "qcom,gpu-dump-skip-cdev";
		nvmem-cells = <&wr_thermal_flag>;
		nvmem-cell-names = "wr_thermal_flag";
		#cooling-cells = <0x2>;
	};
};

