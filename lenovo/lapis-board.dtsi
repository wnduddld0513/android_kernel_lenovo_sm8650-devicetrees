			};

			lbat_gpu2 {
				trip = <&b_bcl_lvl2>;
				cooling-device = <&msm_gpu 0x5 0xffffffff>;
			};
		};
	};

	pm8550-bcl-lvl0 {

		cooling-maps {

			vph_modem0 {
				trip = <&bcl_lvl0>;
