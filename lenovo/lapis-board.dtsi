&spmi_bus {
	#address-cells = <0x2>;
	#size-cells = <0x0>;
	interrupt-controller;
	#interrupt-cells = <0x4>;

	qcom,pm8010@c {
		compatible = "qcom,spmi-pmic";
		reg = <0xc 0x0>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		pm8010m_tz: pm8010m-temp-alarm@2400 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0x2400>;
			interrupts = <0xc 0x24 0x0 0x3>;
			#thermal-sensor-cells = <0x0>;
		};
	};

	qcom,pm8010@d {
		compatible = "qcom,spmi-pmic";
		reg = <0xd 0x0>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		pm8010n_tz: pm8010n-temp-alarm@2400 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0x2400>;
			interrupts = <0xd 0x24 0x0 0x3>;
			#thermal-sensor-cells = <0x0>;
		};
	};
};

&thermal_zones {

	pm8010m_tz {
		polling-delay-passive = <0x64>;
		polling-delay = <0x0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8010m_tz>;

		trips {

			trip0 {
				temperature = <0x17318>;
				hysteresis = <0x0>;
				type = "passive";
			};

			trip1 {
				temperature = <0x1c138>;
				hysteresis = <0x0>;
				type = "critical";
			};

			trip2 {
				temperature = <0x23668>;
				hysteresis = <0x0>;
				type = "critical";
			};
		};
	};

	pm8010n_tz {
		polling-delay-passive = <0x64>;
		polling-delay = <0x0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8010n_tz>;

		trips {

			trip0 {
				temperature = <0x17318>;
				hysteresis = <0x0>;
				type = "passive";
			};

			trip1 {
				temperature = <0x1c138>;
				hysteresis = <0x0>;
				type = "critical";
			};

			trip2 {
				temperature = <0x23668>;
				hysteresis = <0x0>;
				type = "critical";
			};
		};
	};
};

&spmi_bus {
	#address-cells = <0x2>;
	#size-cells = <0x0>;
	interrupt-controller;
	#interrupt-cells = <0x4>;

	qcom,pm8550@1 {
		compatible = "qcom,spmi-pmic";
		reg = <0x1 0x0>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		pm8550_tz: pm8550-temp-alarm@a00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xa00>;
			interrupts = <0x1 0xa 0x0 0x3>;
			#thermal-sensor-cells = <0x0>;
			io-channels = <&pmk8550_vadc 0x103>;
			io-channel-names = "thermal";
		};

		pm8550_gpios: pinctrl@8800 {
			compatible = "qcom,pm8550-gpio";
			reg = <0x8800>;
			gpio-controller;
			#gpio-cells = <0x2>;
			interrupt-controller;
			#interrupt-cells = <0x2>;

			key_vol_up {

				key_vol_up_default: key_vol_up_default {
					pins = "gpio6";
					function = "normal";
					input-enable;
					bias-pull-up;
					power-source = <0x1>;
				};
			};

			sd_card_det {

				sd_card_det_default: sd_card_det_default {
				};
			};

			pm8550_fast_chg_therm {

				pm8550_fast_chg_therm_default: pm8550_fast_chg_therm_default {
					pins = "gpio12";
					bias-high-impedance;
				};
			};

			display_panel_avdd_default: display_panel_avdd_default {
				qcom,drive-strength = <0x3>;
				power-source = <0x1>;
				bias-disable;
				output-enable;
				input-disable;
				function = "normal";
				pins = "gpio11";
			};
		};

		pm8550_pwm_1: pwms@e800 {
			compatible = "qcom,pwm-lpg";
			reg = <0xe800>;
			reg-names = "lpg-base";
			#pwm-cells = <0x2>;
			qcom,num-lpg-channels = <0x3>;
			nvmem = <&pmk8550_sdam_21 &pmk8550_sdam_22>;
			nvmem-names = "lpg_chan_sdam", "lut_sdam";
			qcom,lut-sdam-base = <0x45>;
			qcom,lut-patterns = <0x0 0xa 0x14 0x1e 0x28 0x32 0x3c 0x46 0x50 0x5a 0x64 0x5a 0x50 0x46 0x3c 0x32 0x28 0x1e 0x14 0xa 0x0>;
			qcom,tick-duration-us = <0x1e78>;

			lpg@1 {
				qcom,lpg-chan-id = <0x1>;
				qcom,ramp-step-ms = <0x64>;
				qcom,ramp-low-index = <0x0>;
				qcom,ramp-high-index = <0x13>;
				qcom,ramp-pattern-repeat;
				qcom,lpg-sdam-base = <0x48>;
			};

			lpg@2 {
				qcom,lpg-chan-id = <0x2>;
				qcom,ramp-step-ms = <0x64>;
				qcom,ramp-low-index = <0x0>;
				qcom,ramp-high-index = <0x13>;
				qcom,ramp-pattern-repeat;
				qcom,lpg-sdam-base = <0x56>;
			};

			lpg@3 {
				qcom,lpg-chan-id = <0x3>;
				qcom,ramp-step-ms = <0x64>;
				qcom,ramp-low-index = <0x0>;
				qcom,ramp-high-index = <0x13>;
				qcom,ramp-pattern-repeat;
				qcom,lpg-sdam-base = <0x64>;
			};
		};

		pwms@eb00 {
			compatible = "qcom,pwm-lpg";
			reg = <0xeb00>;
			reg-names = "lpg-base";
			pwm-cells = <0x2>;
			qcom,num-lpg-channels = <0x1>;
		};

		qcom,leds@ef00 {
			compatible = "qcom,tri-led";
			reg = <0xef00>;

			red {
				label = "red";
				pwms = <&pm8550_pwm_1 0x0 0xf4240>;
				led-sources = <0x0>;
				linux,default-trigger = "timer";
			};

			green {
				label = "green";
				pwms = <&pm8550_pwm_1 0x1 0xf4240>;
				led-sources = <0x1>;
				linux,default-trigger = "timer";
			};

			blue {
				label = "blue";
				pwms = <&pm8550_pwm_1 0x2 0xf4240>;
				led-sources = <0x2>;
				linux,default-trigger = "timer";
			};
		};

		pm8550_bcl: bcl@4700 {
			compatible = "qcom,bcl-v5";
			reg = <0x4700 0x100>;
			interrupts = <0x1 0x47 0x0 0x0 0x1 0x47 0x1 0x0 0x1 0x47 0x2 0x0>;
			interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
			qcom,pmic7-threshold;
			#thermal-sensor-cells = <0x1>;
		};

		qcom,flash_led@ee00 {
			compatible = "qcom,pm8350c-flash-led";
			reg = <0xee00>;
			interrupts = <0x1 0xee 0x0 0x1 0x1 0xee 0x3 0x1 0x1 0xee 0x4 0x1>;
			interrupt-names = "led-fault-irq", "all-ramp-down-done-irq", "all-ramp-up-done-irq";
			qcom,thermal-derate-current = <0xc8 0x1f4>;
			status = "ok";

			pm8550_flash0: qcom,flash_0 {
				label = "flash";
				qcom,led-name = "led:flash_0";
				qcom,max-current-ma = <0x5dc>;
				qcom,default-led-trigger = "flash0_trigger";
				qcom,id = <0x0>;
				qcom,duration-ms = <0x500>;
				qcom,ires-ua = <0x30d4>;
			};

			qcom,flash_1 {
				label = "flash";
				qcom,led-name = "led:flash_1";
				qcom,max-current-ma = <0x5dc>;
				qcom,default-led-trigger = "flash1_trigger";
				qcom,id = <0x1>;
				qcom,duration-ms = <0x500>;
				qcom,ires-ua = <0x30d4>;
			};

			qcom,flash_2 {
				label = "flash";
				qcom,led-name = "led:flash_2";
				qcom,max-current-ma = <0x5dc>;
				qcom,default-led-trigger = "flash2_trigger";
				qcom,id = <0x2>;
				qcom,duration-ms = <0x500>;
				qcom,ires-ua = <0x30d4>;
			};

			pm8550_flash3: qcom,flash_3 {
				label = "flash";
				qcom,led-name = "led:flash_3";
				qcom,max-current-ma = <0x5dc>;
				qcom,default-led-trigger = "flash3_trigger";
				qcom,id = <0x3>;
				qcom,duration-ms = <0x500>;
				qcom,ires-ua = <0x30d4>;
			};

			pm8550_torch0: qcom,torch_0 {
				label = "torch";
				qcom,led-name = "led:torch_0";
				qcom,max-current-ma = <0x1f4>;
				qcom,default-led-trigger = "torch0_trigger";
				qcom,id = <0x0>;
				qcom,ires-ua = <0x30d4>;
			};

			qcom,torch_1 {
				label = "torch";
				qcom,led-name = "led:torch_1";
				qcom,max-current-ma = <0x1f4>;
				qcom,default-led-trigger = "torch1_trigger";
				qcom,id = <0x1>;
				qcom,ires-ua = <0x30d4>;
			};

			qcom,torch_2 {
				label = "torch";
				qcom,led-name = "led:torch_2";
				qcom,max-current-ma = <0x1f4>;
				qcom,default-led-trigger = "torch2_trigger";
				qcom,id = <0x2>;
				qcom,ires-ua = <0x30d4>;
			};

			pm8550_torch3: qcom,torch_3 {
				label = "torch";
				qcom,led-name = "led:torch_3";
				qcom,max-current-ma = <0x1f4>;
				qcom,default-led-trigger = "torch3_trigger";
				qcom,id = <0x3>;
				qcom,ires-ua = <0x30d4>;
			};

			qcom,led_switch_0 {
				label = "switch";
				qcom,led-name = "led:switch_0";
				qcom,default-led-trigger = "switch0_trigger";
				qcom,led-mask = <0x9>;
				qcom,symmetry-en;
			};

			qcom,led_switch_1 {
				label = "switch";
				qcom,led-name = "led:switch_1";
				qcom,default-led-trigger = "switch1_trigger";
				qcom,led-mask = <0x6>;
				qcom,symmetry-en;
			};

			pm8550_switch2: qcom,led_switch_2 {
				label = "switch";
				qcom,led-name = "led:switch_2";
				qcom,default-led-trigger = "switch2_trigger";
				qcom,led-mask = <0xf>;
				qcom,symmetry-en;
			};
		};
	};
};

&thermal_zones {

	pm8550_tz {
		polling-delay-passive = <0x64>;
		polling-delay = <0x0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8550_tz>;

		trips {

			trip0 {
				temperature = <0x17318>;
				hysteresis = <0x0>;
				type = "passive";
			};

			trip1 {
				temperature = <0x1c138>;
				hysteresis = <0x0>;
				type = "passive";
			};

			trip2 {
				temperature = <0x23668>;
				hysteresis = <0x0>;
				type = "critical";
			};
		};
	};

	pm8550-bcl-lvl0 {
		polling-delay-passive = <0x64>;
		polling-delay = <0x0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8550_bcl 0x5>;

		trips {

			bcl_lvl0: bcl-lvl0 {
				temperature = <0x1>;
				hysteresis = <0x1>;
				type = "passive";
			};
		};
	};

	pm8550-bcl-lvl1 {
		polling-delay-passive = <0x64>;
		polling-delay = <0x0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8550_bcl 0x6>;

		trips {

			bcl_lvl1: bcl-lvl1 {
				temperature = <0x1>;
				hysteresis = <0x1>;
				type = "passive";
			};
		};
	};

	pm8550-bcl-lvl2 {
		polling-delay-passive = <0x64>;
		polling-delay = <0x0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8550_bcl 0x7>;

		trips {

			bcl_lvl2: bcl-lvl2 {
				temperature = <0x1>;
				hysteresis = <0x1>;
				type = "passive";
			};
		};
	};
};

&spmi_bus {
	#address-cells = <0x2>;
	#size-cells = <0x0>;
	interrupt-controller;
	#interrupt-cells = <0x4>;

	qcom,pm8550b@7 {
		compatible = "qcom,spmi-pmic";
		reg = <0x7 0x0>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		pm8550b_tz: pm8550b-temp-alarm@a00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xa00>;
			interrupts = <0x7 0xa 0x0 0x3>;
			#thermal-sensor-cells = <0x0>;
			io-channels = <&pmk8550_vadc 0x703>;
			io-channel-names = "thermal";
		};

		pm8550b_lite_tz: pm8550b-temp-alarm-lite@c00 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0xc00>;
			interrupts = <0x7 0xc 0x0 0x3>;
			#thermal-sensor-cells = <0x0>;
			io-channels = <&pmk8550_vadc 0x718>;
			io-channel-names = "thermal";
		};

		pinctrl@8800 {
			compatible = "qcom,pm8550b-gpio";
			reg = <0x8800>;
			gpio-controller;
			#gpio-cells = <0x2>;
			interrupt-controller;
			#interrupt-cells = <0x2>;
		};

		qcom,hv-haptics@f000 {
			compatible = "qcom,hv-haptics";
			reg = <0xf000 0xf100 0xf200>;
			interrupts = <0x7 0xf0 0x1 0x1>;
			interrupt-names = "fifo-empty";
			qcom,vmax-mv = <0x6a4>;
			qcom,brake-mode = <0x1>;
			qcom,brake-pattern = [ff 3f 1f];
			qcom,lra-period-us = <0x16f8>;
			qcom,drv-sig-shape = <0x1>;
			qcom,brake-sig-shape = <0x1>;
			nvmem-names = "hap_cfg_sdam";
			nvmem = <&pmk8550_sdam_46>;

			hap_swr_slave_reg: qcom,hap-swr-slave-reg {
				regulator-name = "hap-swr-slave-reg";
			};

			effect_0 {
				qcom,effect-id = <0x0>;
				qcom,wf-vmax-mv = <0x708>;
				qcom,wf-pattern-data = <0x1f 0x0 0x0 0x3f 0x0 0x0 0x5f 0x0 0x0 0x7f 0x0 0x0 0x17f 0x0 0x0 0x15f 0x0 0x0 0x13f 0x0 0x0 0x11f 0x0 0x0>;
				qcom,wf-pattern-period-us = <0x16f8>;
				qcom,wf-brake-pattern = [00 00 00];
				qcom,wf-pattern-preload;
				qcom,wf-auto-res-disable;
			};

			effect_1 {
				qcom,effect-id = <0x1>;
				qcom,wf-vmax-mv = <0x708>;
				qcom,wf-pattern-data = <0x1f 0x0 0x0 0x3f 0x0 0x0 0x5f 0x0 0x0 0x7f 0x0 0x0 0x17f 0x0 0x0 0x15f 0x0 0x0 0x13f 0x0 0x0 0x11f 0x0 0x0>;
				qcom,wf-pattern-period-us = <0x16f8>;
				qcom,wf-brake-pattern = [00 00 00];
				qcom,wf-auto-res-disable;
			};

			effect_2 {
				qcom,effect-id = <0x2>;
				qcom,wf-vmax-mv = <0x708>;
				qcom,wf-pattern-data = <0x1f 0x0 0x0 0x3f 0x0 0x0 0x5f 0x0 0x0 0x7f 0x0 0x0 0x17f 0x0 0x0 0x15f 0x0 0x0 0x13f 0x0 0x0 0x11f 0x0 0x0>;
				qcom,wf-pattern-period-us = <0x16f8>;
				qcom,wf-brake-pattern = [00 00 00];
				qcom,wf-auto-res-disable;
			};

			effect_3 {
				qcom,effect-id = <0x3>;
				qcom,wf-vmax-mv = <0x708>;
				qcom,wf-pattern-data = <0x1f 0x0 0x0 0x3f 0x0 0x0 0x5f 0x0 0x0 0x7f 0x0 0x0 0x17f 0x0 0x0 0x15f 0x0 0x0 0x13f 0x0 0x0 0x11f 0x0 0x0>;
				qcom,wf-pattern-period-us = <0x16f8>;
				qcom,wf-brake-pattern = [00 00 00];
				qcom,wf-auto-res-disable;
			};

			effect_4 {
				qcom,effect-id = <0x4>;
				qcom,wf-vmax-mv = <0x708>;
				qcom,wf-pattern-data = <0x1f 0x0 0x0 0x3f 0x0 0x0 0x5f 0x0 0x0 0x7f 0x0 0x0 0x17f 0x0 0x0 0x15f 0x0 0x0 0x13f 0x0 0x0 0x11f 0x0 0x0>;
				qcom,wf-pattern-period-us = <0x16f8>;
				qcom,wf-brake-pattern = [00 00 00];
				qcom,wf-auto-res-disable;
			};

			effect_5 {
				qcom,effect-id = <0x5>;
				qcom,wf-vmax-mv = <0x708>;
				qcom,wf-pattern-data = <0x1f 0x0 0x0 0x3f 0x0 0x0 0x5f 0x0 0x0 0x7f 0x0 0x0 0x17f 0x0 0x0 0x15f 0x0 0x0 0x13f 0x0 0x0 0x11f 0x0 0x0>;
				qcom,wf-pattern-period-us = <0x16f8>;
				qcom,wf-brake-pattern = [00 00 00];
				qcom,wf-auto-res-disable;
			};

			primitive_0 {
				qcom,primitive-id = <0x0>;
				qcom,wf-vmax-mv = <0x708>;
				qcom,wf-pattern-data = <0x0 0x0 0x0 0x0 0x0 0x0>;
				qcom,wf-pattern-period-us = <0x16f8>;
				qcom,wf-brake-pattern = [00 00 00];
				qcom,wf-auto-res-disable;
			};

			primitive_1 {
				qcom,primitive-id = <0x1>;
				qcom,wf-vmax-mv = <0x708>;
				qcom,wf-pattern-data = <0xff 0x0 0x0 0x7f 0x0 0x0>;
				qcom,wf-pattern-period-us = <0x16f8>;
				qcom,wf-brake-pattern = [00 00 00];
				qcom,wf-auto-res-disable;
			};

			primitive_2 {
				qcom,primitive-id = <0x2>;
				qcom,wf-vmax-mv = <0x708>;
				qcom,wf-pattern-data = <0xff 0x0 0x0 0x7f 0x0 0x0>;
				qcom,wf-pattern-period-us = <0x16f8>;
				qcom,wf-brake-pattern = [00 00 00];
				qcom,wf-auto-res-disable;
			};

			primitive_3 {
				qcom,primitive-id = <0x3>;
				qcom,wf-vmax-mv = <0x708>;
				qcom,wf-pattern-data = <0xff 0x0 0x0 0x7f 0x0 0x0>;
				qcom,wf-pattern-period-us = <0x16f8>;
				qcom,wf-brake-pattern = [00 00 00];
				qcom,wf-auto-res-disable;
			};

			primitive_4 {
				qcom,primitive-id = <0x4>;
				qcom,wf-vmax-mv = <0x708>;
				qcom,wf-pattern-data = <0xff 0x0 0x0 0x7f 0x0 0x0>;
				qcom,wf-pattern-period-us = <0x16f8>;
				qcom,wf-brake-pattern = [00 00 00];
				qcom,wf-auto-res-disable;
			};

			primitive_5 {
				qcom,primitive-id = <0x5>;
				qcom,wf-vmax-mv = <0x708>;
				qcom,wf-pattern-data = <0xff 0x0 0x0 0x7f 0x0 0x0>;
				qcom,wf-pattern-period-us = <0x16f8>;
				qcom,wf-brake-pattern = [00 00 00];
				qcom,wf-auto-res-disable;
			};

			primitive_6 {
				qcom,primitive-id = <0x6>;
				qcom,wf-vmax-mv = <0x708>;
				qcom,wf-pattern-data = <0xff 0x0 0x0 0x7f 0x0 0x0>;
				qcom,wf-pattern-period-us = <0x16f8>;
				qcom,wf-brake-pattern = [00 00 00];
				qcom,wf-auto-res-disable;
			};

			primitive_7 {
				qcom,primitive-id = <0x7>;
				qcom,wf-vmax-mv = <0x708>;
				qcom,wf-pattern-data = <0xff 0x0 0x0 0x7f 0x0 0x0>;
				qcom,wf-pattern-period-us = <0x16f8>;
				qcom,wf-brake-pattern = [00 00 00];
				qcom,wf-auto-res-disable;
			};

			primitive_8 {
				qcom,primitive-id = <0x8>;
				qcom,wf-vmax-mv = <0x708>;
				qcom,wf-pattern-data = <0xff 0x0 0x0 0x7f 0x0 0x0>;
				qcom,wf-pattern-period-us = <0x16f8>;
				qcom,wf-brake-pattern = [00 00 00];
				qcom,wf-auto-res-disable;
			};
		};

		pm8550b_bcl: bcl@4700 {
			compatible = "qcom,bcl-v5";
			reg = <0x4700 0x100>;
			interrupts = <0x7 0x47 0x0 0x0 0x7 0x47 0x1 0x0 0x7 0x47 0x2 0x0>;
			interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
			qcom,pmic7-threshold;
			#thermal-sensor-cells = <0x1>;
		};

		bcl_soc: bcl-soc {
			compatible = "qcom,msm-bcl-soc";
			#thermal-sensor-cells = <0x0>;
		};

		pm8550b_eusb2_repeater: qcom,eusb2-repeater@fd00 {
			compatible = "qcom,pmic-eusb2-repeater";
			reg = <0xfd00>;
			vdd18-supply = <&pm_humu_l15>;
			vdd3-supply = <&pm_humu_l5>;
			qcom,param-override-seq = <0xd 0x51 0x2 0x54 0x7 0x57 0x6 0x53 0x0 0x59>;
		};
	};
};

