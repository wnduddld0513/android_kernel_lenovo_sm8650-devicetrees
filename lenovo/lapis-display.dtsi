		qcom,panel-supply-entry@0 {
			qcom,supply-post-on-sleep = <0x14>;
			qcom,supply-disable-load = <0x1f40>;
			qcom,supply-enable-load = <0x35b60>;
			qcom,supply-max-voltage = <0x1b7740>;
			qcom,supply-min-voltage = <0x1b7740>;
			qcom,supply-name = "vddio";
			reg = <0x0>;
		};

		qcom,panel-supply-entry@1 {
			qcom,supply-disable-load = <0x64>;
			qcom,supply-enable-load = <0x3f7a0>;
			qcom,supply-max-voltage = <0x5b8d80>;
			qcom,supply-min-voltage = <0x4630c0>;
			qcom,supply-name = "avdd";
			reg = <0x1>;
		};
	};

	sde_dsi: qcom,dsi-display-primary {
		vdd-supply = <&L11B>;
		vci-supply = <&L13B>;
		vddio-supply = <&L12B>;
		clock-names = "pll_byte_clk0", "pll_dsi_clk0", "pll_byte_clk1", "pll_dsi_clk1", "mdp_core_clk";
		clocks = <&mdss_dsi_phy0 0x0 &mdss_dsi_phy0 0x1 &mdss_dsi_phy1 0x2 &mdss_dsi_phy1 0x3 &dispcc 0x3d>;
		qcom,demura-panel-id = <0x122e700 0x471>;
		qcom,dsi-default-panel = <&dsi_kirby_nt36523_csot_dsc_vid>;
		qcom,mdp = <&mdss_mdp>;
		qcom,panel-te-source = <0x0>;
		qcom,platform-te-gpio = <&tlmm 0x56 0x0>;
		pinctrl-1 = <&sde_dsi_suspend &sde_te_suspend>;
		pinctrl-0 = <&sde_dsi_active &sde_te_active>;
		pinctrl-names = "panel_active", "panel_suspend";
		qcom,dsi-phy = <&mdss_dsi_phy0 &mdss_dsi_phy1>;
		qcom,dsi-ctrl = <&mdss_dsi0 &mdss_dsi1>;
		label = "primary";
		compatible = "qcom,dsi-display";
	};

	sde_dsi1: qcom,dsi-display-secondary {
		vdd-supply = <&L11B>;
		vci-supply = <&L13B>;
		vddio-supply = <&L12B>;
		clock-names = "pll_byte_clk0", "pll_dsi_clk0", "pll_byte_clk1", "pll_dsi_clk1", "mdp_core_clk";
		clocks = <&mdss_dsi_phy0 0x0 &mdss_dsi_phy0 0x1 &mdss_dsi_phy1 0x2 &mdss_dsi_phy1 0x3 &dispcc 0x3d>;
		qcom,demura-panel-id = <0x0 0x0>;
		qcom,mdp = <&mdss_mdp>;
		qcom,panel-te-source = <0x1>;
		qcom,platform-te-gpio = <&tlmm 0x56 0x0>;
		pinctrl-1 = <&sde_dsi1_suspend &sde_te1_suspend>;
		pinctrl-0 = <&sde_dsi1_active &sde_te1_active>;
		pinctrl-names = "panel_active", "panel_suspend";
		qcom,dsi-phy = <&mdss_dsi_phy0 &mdss_dsi_phy1>;
		qcom,dsi-ctrl = <&mdss_dsi0 &mdss_dsi1>;
		label = "secondary";
		compatible = "qcom,dsi-display";
	};
};

&soc {

	sde_wb1: qcom,wb-display@1 {
		clock-names = "mdp_core_clk";
		clocks = <&dispcc 0x3d>;
		label = "wb_display1";
		cell-index = <0x0>;
		compatible = "qcom,wb-display";
	};

	sde_wb2: qcom,wb-display@2 {
		clock-names = "mdp_core_clk";
		clocks = <&dispcc 0x3d>;
		label = "wb_display2";
		cell-index = <0x1>;
		compatible = "qcom,wb-display";
	};

	display_panel_avdd: display_gpio_regulator@1 {
		pinctrl-0 = <&display_panel_avdd_default>;
		pinctrl-names = "default";
		qcom,proxy-consumer-enable;
		proxy-supply = <&display_panel_avdd>;
		regulator-boot-on;
		enable-active-high;
		gpio = <&pm8550_gpios 0xb 0x0>;
		regulator-enable-ramp-delay = <0xe9>;
		regulator-max-microvolt = <0x53ec60>;
		regulator-min-microvolt = <0x53ec60>;
		regulator-name = "display_panel_avdd";
		compatible = "qti-regulator-fixed";
	};

	disp_rdump_region@d5100000 {
		label = "disp_rdump_region";
		reg = <0xd5100000 0x800000>;
	};
};

&reserved_memory {

	splash_region {
		label = "cont_splash_region";
		reg = <0x0 0xd5100000 0x0 0x2b00000>;
	};

	demura_region_0 {
		label = "demura hfc region 0";
		reg = <0x0 0x0 0x0 0x0>;
	};

	demura_region_1 {
		label = "demura hfc region 1";
		reg = <0x0 0x0 0x0 0x0>;
	};
};

&qupv3_se4_spi {

	novatek@0 {
		panel = <&dsi_kirby_nt36523_csot_dsc_vid &dsi_kirby_nt36523_boe_dsc_vid &dsi_panel_lapis_tianma_nt36532_dsc_3k_video &dsi_panel_lapis_boe_nt36532_dsc_3k_video &dsi_kirby_nt36523_boe_dsc_hyper_vid>;
	};
};

&battery_charger {
	qcom,display-panels = <&dsi_panel_lapis_tianma_nt36532_dsc_3k_video &dsi_panel_lapis_boe_nt36532_dsc_3k_video>;
};
