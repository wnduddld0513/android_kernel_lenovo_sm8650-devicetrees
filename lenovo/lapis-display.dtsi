		qcom,hbr2-3-pre-emphasis = <0x0 0xc 0x15 0x1b 0x2 0xe 0x16 0xff 0x2 0x11 0xff 0xff 0x4 0xff 0xff 0xff>;
		qcom,hbr2-3-voltage-swing = <0x2 0x12 0x16 0x1a 0x9 0x19 0x1f 0xff 0x10 0x1f 0xff 0xff 0x1f 0xff 0xff 0xff>;
		qcom,hbr-rbr-pre-emphasis = <0x0 0xd 0x14 0x1a 0x0 0xe 0x15 0xff 0x0 0xe 0xff 0xff 0x2 0xff 0xff 0xff>;
		qcom,hbr-rbr-voltage-swing = <0x7 0xf 0x16 0x1f 0x11 0x1e 0x1f 0xff 0x16 0x1f 0xff 0xff 0x1f 0xff 0xff 0xff>;
		dp_phy_gdsc-supply = <&gcc_usb3_phy_gdsc>;
		vdd_mx-supply = <&VDD_MXA_LEVEL>;
		vdda_usb-0p9-supply = <&L1I>;
		vdda-0p9-supply = <&L3G>;
		vdda-1p2-supply = <&L3I>;
		qcom,qos-cpu-latency-us = <0x12c>;
		qcom,qos-cpu-mask = <0xf>;
		qcom,dsc-continuous-pps;
		qcom,fec-feature-enable;
		qcom,dsc-feature-enable;
		qcom,mst-enable;
		qcom,widebus-enable;
		qcom,max-pclk-frequency-khz = <0xa4cb8>;
		qcom,aux-cfg9-settings = [44 03];
		qcom,aux-cfg8-settings = [40 b7];
		qcom,aux-cfg7-settings = [3c 03];
		qcom,aux-cfg6-settings = [38 0a];
		qcom,aux-cfg5-settings = [34 26];
		qcom,aux-cfg4-settings = [30 0a];
		qcom,aux-cfg3-settings = ",";
		qcom,aux-cfg2-settings = [28 a4];
		qcom,aux-cfg1-settings = [24 13];
		qcom,aux-cfg0-settings = " ";
		qcom,phy-version = <0x600>;
		qcom,pll-revision = "4nm-v1.1";
		clock-names = "core_aux_clk", "rpmh_cxo_clk", "core_usb_ref_clk_src", "core_usb_pipe_clk", "link_clk", "link_clk_src", "link_parent", "link_iface_clk", "pixel_clk_rcg", "pixel_parent", "pixel1_clk_rcg", "strm0_pixel_clk", "strm1_pixel_clk";
		clocks = <&dispcc 0xc &rpmhcc 0x0 &tcsrcc 0x5 &gcc 0xb9 &dispcc 0xf &dispcc 0x10 &sde_dp 0x0 &dispcc 0x12 &dispcc 0x14 &sde_dp 0x1 &dispcc 0x16 &dispcc 0x13 &dispcc 0x15>;
		#clock-cells = <0x1>;
		interrupts = <0xc 0x0>;
		interrupt-parent = <&mdss_mdp>;
		reg-names = "dp_ahb", "dp_aux", "dp_link", "dp_p0", "dp_phy", "dp_ln_tx0", "dp_ln_tx1", "dp_pll", "usb3_dp_com", "hdcp_physical", "dp_p1", "gdsc";
		reg = <0xaf54000 0x104 0xaf54200 0xc0 0xaf55000 0x770 0xaf56000 0x9c 0x88eaa00 0x200 0x88ea200 0x200 0x88ea600 0x200 0x88ea000 0x200 0x88e8000 0x20 0xaee1000 0x34 0xaf57000 0x9c 0xaf09000 0x14>;
		qcom,dp-aux-switch = <&wcd_usbss>;
		qcom,altmode-dev = <&altmode 0x0>;
		usb-controller = <&usb0>;
		qcom,ext-disp = <&ext_disp>;
		usb-phy = <&usb_qmp_dp_phy>;
		compatible = "qcom,dp-display";
		cell-index = <0x0>;

		qcom,ctrl-supply-entries {
			#size-cells = <0x0>;
			#address-cells = <0x1>;

			qcom,ctrl-supply-entry@0 {
				qcom,supply-disable-load = <0x0>;
				qcom,supply-enable-load = <0x7594>;
				qcom,supply-max-voltage = <0x124f80>;
				qcom,supply-min-voltage = <0x124f80>;
				qcom,supply-name = "vdda-1p2";
				reg = <0x0>;
			};
		};

		qcom,phy-supply-entries {
			#size-cells = <0x0>;
			#address-cells = <0x1>;

			qcom,phy-supply-entry@0 {
				qcom,supply-disable-load = <0x0>;
				qcom,supply-enable-load = <0x1c138>;
				qcom,supply-max-voltage = <0xdea80>;
				qcom,supply-min-voltage = <0xdea80>;
				qcom,supply-name = "vdda-0p9";
				reg = <0x0>;
			};

			qcom,phy-supply-entry@1 {
				qcom,supply-disable-load = <0x0>;
				qcom,supply-enable-load = <0x1964>;
				qcom,supply-max-voltage = <0xd6d80>;
				qcom,supply-min-voltage = <0xd6d80>;
				qcom,supply-name = "vdda_usb-0p9";
				reg = <0x1>;
			};
		};

		qcom,pll-supply-entries {
			#size-cells = <0x0>;
			#address-cells = <0x1>;

			qcom,pll-supply-entry@0 {
				qcom,supply-disable-load = <0x0>;
				qcom,supply-enable-load = <0x0>;
				qcom,supply-max-voltage = <0xffff>;
				qcom,supply-min-voltage = <0x180>;
				qcom,supply-name = "vdd_mx";
				reg = <0x0>;
			};
		};
	};

	sde_rscc: qcom,sde_rscc@af20000 {
		interconnect-names = "qcom,sde-data-bus0";
		interconnects = <&mmss_noc 0x3e9 &mc_virt 0x5e8>;
		qcom,msm-bus,active-only;
		clock-names = "vsync_clk", "gdsc_clk", "iface_clk";
		clocks = <&dispcc 0x47 &dispcc 0x41 &dispcc 0x46>;
		vdd-supply = <&disp_cc_mdss_core_gdsc>;
		qcom,sde-dram-channels = <0x2>;
		qcom,sde-rsc-version = <0x5>;
		reg-names = "drv", "wrapper";
		reg = <0xaf20000 0x4d68 0xaf30000 0x3fd4>;
		compatible = "qcom,sde-rsc";
		cell-index = <0x0>;
	};

	smmu_sde_unsec: qcom,smmu_sde_unsec_cb {
		clock-names = "mdp_core_clk";
		clocks = <&dispcc 0x3d>;
		dma-coherent;
		qcom,iommu-earlymap;
		qcom,iommu-faults = "non-fatal";
		qcom,iommu-dma-addr-pool = <0x60000 0xd50a0000 0xd7c00000 0x283f0000>;
		iommus = <&apps_smmu 0x1c00 0x2>;
		compatible = "qcom,smmu_sde_unsec";
	};

	qcom,smmu_sde_sec_cb {
		qcom,iommu-vmid = <0xa>;
		qcom,iommu-faults = "non-fatal";
		qcom,iommu-dma-addr-pool = <0x20000 0xfffe0000>;
		iommus = <&apps_smmu 0x1c01 0x0>;
		compatible = "qcom,smmu_sde_sec";
	};
};

&disp_rsc_drv0 {

	sde_rsc_rpmh {
		cell-index = <0x0>;
		compatible = "qcom,sde-rsc-rpmh";
	};
};

&tlmm {

	pmx_sde {

		sde_dsi_active: sde_dsi_active {

			mux {
				function = "gpio";
				pins = "gpio133";
			};

			config {
				bias-disable = <0x0>;
				drive-strength = <0x8>;
				pins = "gpio133";
			};
		};

		sde_dsi_suspend: sde_dsi_suspend {

			mux {
				function = "gpio";
				pins = "gpio133";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio133";
			};
		};

		sde_dsi1_active: sde_dsi1_active {

			mux {
				function = "gpio";
				pins = "gpio137";
			};

			config {
				bias-disable = <0x0>;
				drive-strength = <0x8>;
				pins = "gpio137";
			};
		};

		sde_dsi1_suspend: sde_dsi1_suspend {

			mux {
				function = "gpio";
				pins = "gpio137";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio137";
			};
		};
	};

	pmx_sde_te {

		sde_te_active: sde_te_active {

			mux {
				function = "mdp_vsync";
				pins = "gpio86";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio86";
			};
		};

		sde_te_suspend: sde_te_suspend {

			mux {
				function = "mdp_vsync";
				pins = "gpio86";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio86";
			};
		};

		sde_te1_active: sde_te1_active {

			mux {
				function = "mdp_vsync";
				pins = "gpio199";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio199";
			};
		};

		sde_te1_suspend: sde_te1_suspend {

			mux {
				function = "mdp_vsync";
				pins = "gpio199";
			};

			config {
				bias-pull-down;
				drive-strength = <0x2>;
				pins = "gpio199";
			};
		};
	};
};

